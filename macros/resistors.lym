<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Microresistor test-structure mask</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>"""Microresistor test-structure mask -- example run script.

Copy this into ~/.klayout/pymacros/ and run it from
Macros -&gt; Macro Development (F5) as a Python macro.

Everything reusable lives in the installed `microresistor` package; this file
holds only what is specific to ONE mask: the process, the device sweep, the pad
style, the floorplan, and where the GDS goes. Set MICRORESISTOR_OUT to choose
the output path, or edit DEFAULT_OUT below.

Four mask layers:
    1/0   resistor film
    3/0   pad film (thicker, more conductive -- a different deposition)
   10/0   drawn text labels
    0/0   die boundary. NOT a patterned layer: it records where the die ends,
          for dicing and floorplanning. The silicon substrate itself is not
          drawn at all -- it is unpatterned starting material, so there is no
          mask for it, and its electrical properties belong in Process.

Install the library with:
    uv pip install \
        --python /Library/Developer/CommandLineTools/usr/bin/python3 \
        --target ~/.klayout/python \
        git+ssh://git@github.com/aRustyDev/klayout-lib.git
"""

import os
import sys

# KLayout keeps modules in sys.modules across F5 runs within one session, so an
# edit to the library would otherwise not be picked up without restarting.
# Purging rather than importlib.reload(): reload() does not recursively reload
# a package's submodules. Must happen BEFORE the import below.
DEV_RELOAD = True
if DEV_RELOAD:
    for _name in [n for n in list(sys.modules)
                  if n == "microresistor" or n.startswith("microresistor.")]:
        del sys.modules[_name]

import pya

from microresistor import (AUTO, DBU, Corner, CornerSpec, Dogbone, GreekCross,
                           Lead, Pad, PadPlan, Process, Serpentine,
                           StraightBar, alignment_marks, build_cells,
                           die_outline, fits_in_die, grid, report_lines)

# ---------------------------------------------------------------------------
# Mask setup
# ---------------------------------------------------------------------------

PROCESS = Process()  # nothing known yet -- fill in from your measurements

RESISTOR_LAYER = (1, 0)
PAD_LAYER = (3, 0)
LABEL_LAYER = (10, 0)
DIE_LAYER = (0, 0)

# Two pad styles, mixed across the sweep. An OVERLAP pad contacts the trace
# directly and adds no lead resistance, but needs a device longer than the pad
# is wide. A LEADED pad sits clear of the device and straps back, which is the
# only way a 10 um bar can carry a 40 um probe pad.
#
# Devices listed bare take AUTO: overlap where it fits, lead where it does not.
# Name a pad explicitly in DEVICES to override, or None to draw that one bare.
PAD_CORNER = CornerSpec(Corner.TAPERED, chamfer_um=6)
OVERLAP = Pad(size_um=40, corner=PAD_CORNER)
LEADED = Pad(size_um=40, corner=PAD_CORNER, lead=Lead(length_um=30))

PADS = PadPlan(overlap=OVERLAP, leaded=LEADED)

COLS = 3               # measured squarest for this sweep
GAP_UM = 100.0
DIE_MARGIN_UM = 150.0  # clearance from the outermost geometry to the die edge

# Corner treatments, reused below so the comparison is like for like.
MITER = CornerSpec(Corner.TAPERED, chamfer_um=4)
FILLET = CornerSpec(Corner.ROUNDED, radius_um=12)

# Entries are a device, or (device, pad) to override the plan. A bare device
# takes AUTO.
DEVICES = [
    # --- sheet-resistance sweep: W fixed, L swept ---------------------
    # The short three cannot take an overlapping pad, so AUTO leads them out;
    # the long two get the overlap. That is the mix, decided by geometry.
    StraightBar(10, 10),        # 1 square, contact-dominated
    StraightBar(20, 10),
    StraightBar(50, 10),
    StraightBar(100, 10),
    StraightBar(200, 10),
    # --- L fixed, W swept ---------------------------------------------
    StraightBar(100, 5),
    StraightBar(100, 20),
    StraightBar(100, 50),
    StraightBar(20, 2),         # same ratio as L100/W10, 1/100 the area
    # --- a matched pair: one resistor, both pad styles -----------------
    # Same geometry, so the difference between them IS the lead plus the
    # contact-area change. AUTO would give both the overlap, so both are named.
    (StraightBar(100, 10, name="BAR_PAIR_OVERLAP"), OVERLAP),
    (StraightBar(100, 10, name="BAR_PAIR_LEADED"), LEADED),
    # --- four-terminal and wide-contact structures --------------------
    Dogbone(50, 4, 20),         # narrow neck, wide contacts
    # A cross is probed from four sides, so force the pads clear of the arms
    # rather than letting them sit on the contacts.
    (GreekCross(arm_width_um=20, arm_length_um=40), LEADED),
    # --- corner-style comparison at matched geometry ------------------
    # Same trace, same fold count: only the bend treatment differs, so the
    # measured resistances isolate the corner's contribution.
    Serpentine(trace_thickness_um=10, leg_length_um=80, n_legs=5, pitch_um=30),
    Serpentine(trace_thickness_um=10, leg_length_um=80, n_legs=5, pitch_um=30,
               corner=MITER),
    Serpentine(trace_thickness_um=10, leg_length_um=80, n_legs=5, pitch_um=30,
               corner=FILLET),
    # --- the same serpentine, described as a wave ---------------------
    # wavelength 60 = pitch 30 (one period is a down-and-up); amplitude 40
    # zero-to-peak = an 80 um leg. Identical to the first serpentine above.
    Serpentine.from_wave(trace_thickness_um=10, amplitude_um=40,
                         length_um=120, wavelength_um=60,
                         name="SRP_WAVE"),
    # --- concave corner treatments ------------------------------------
    # A dogbone's neck-to-head junction and a cross's reentrant corners are
    # CONCAVE, so the fillet adds metal where current would otherwise crowd.
    Dogbone(50, 4, 20, corner=CornerSpec(Corner.ROUNDED, radius_um=3)),
    # LEADED to match its sharp-cornered twin above: if the two crosses were
    # probed differently the corner comparison would be confounded by the pads.
    (GreekCross(arm_width_um=20, arm_length_um=40,
                corner=CornerSpec(Corner.ROUNDED, radius_um=5)), LEADED),
]

DEFAULT_OUT = os.path.expanduser("~/resistors.gds")
OUT = os.environ.get("MICRORESISTOR_OUT", DEFAULT_OUT)


def place_marks(layout, top, metal, pads, content):
    """Two alignment mark sets, diagonally opposite, outside the array.

    Two patterned layers cannot be registered to each other without them, and
    this mask has had two since pads moved off the resistor layer.
    """
    marks = alignment_marks(layout, metal, pads, size_um=100.0)
    inset = int(DIE_MARGIN_UM * 0.5 / DBU)
    for x, y in ((content.left - inset, content.bottom - inset),
                 (content.right + inset, content.top + inset)):
        top.insert(pya.CellInstArray(marks.cell_index(), pya.Trans(x, y)))


def main():
    layout = pya.Layout()
    layout.dbu = DBU
    top = layout.create_cell("TOP")
    metal = layout.layer(*RESISTOR_LAYER)
    pads = layout.layer(*PAD_LAYER)
    die = layout.layer(*DIE_LAYER)

    asm = build_cells(layout, metal, DEVICES, plan=PADS, pad_layer=pads)
    grid(layout, top, asm.cells, cols=COLS, gap_um=GAP_UM,
         label_layer=LABEL_LAYER, label_mag=10.0)

    place_marks(layout, top, metal, pads, top.bbox())

    content = top.bbox()
    box = die_outline(layout, top, die,
                      content.width() * DBU + 2 * DIE_MARGIN_UM,
                      content.height() * DBU + 2 * DIE_MARGIN_UM,
                      centre=(content.center().x * DBU,
                              content.center().y * DBU))

    for line in report_lines(asm.devices, PROCESS, pads=asm.pads):
        print(line)

    print()
    if asm.bare:
        print("bare (no pad fits):",
              ", ".join(d.name for d in asm.bare))
    print(f"die      {box.width() * DBU:7.1f} x {box.height() * DBU:7.1f} um")
    print(f"content  {content.width() * DBU:7.1f} x "
          f"{content.height() * DBU:7.1f} um")
    print(f"fits     {fits_in_die(content, box)}")

    layout.write(OUT)
    print(f"\nwrote {OUT}")


main()</text>
</klayout-macro>
